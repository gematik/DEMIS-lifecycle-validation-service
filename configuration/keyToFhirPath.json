[
  {
    "Bundle.profile(negative)": "Bundle.where(meta.profile = 'https://demis.rki.de/fhir/StructureDefinition/NotificationBundleLaboratoryNegative').exists()",
    "Bundle.profile(!(negative|anonymous))": "Bundle.where(meta.profile = 'https://demis.rki.de/fhir/StructureDefinition/NotificationBundleLaboratoryNegative' or meta.profile = 'https://demis.rki.de/fhir/StructureDefinition/NotificationBundleLaboratoryAnonymous').empty()",
    "Bundle.profile(anonymous)": "Bundle.where(meta.profile = 'https://demis.rki.de/fhir/StructureDefinition/NotificationBundleLaboratoryAnonymous').exists()",
    "Patient.profile(anonymous)": "Bundle.entry.resource.where($this is Patient).meta.where(profile = 'https://demis.rki.de/fhir/StructureDefinition/NotifiedPersonAnonymous').exists()",
    "HasRelatesToEntry": "Bundle.entry.resource.where($this is Composition and relatesTo.exists()).exists()",
    "RelatesToEmpty": "Bundle.entry.resource.where($this is Composition and relatesTo.empty()).exists()",
    "Patient.profile(byName)": "Bundle.entry.resource.where($this is Patient).meta.where(profile = 'https://demis.rki.de/fhir/StructureDefinition/NotifiedPerson').exists()",
    "NotificationId": "Bundle.entry.resource.where($this is Composition).identifier.where(system='https://demis.rki.de/fhir/NamingSystem/NotificationId').value",
    "RelatesToId": "Bundle.entry.resource.where($this is Composition).relatesTo.target.identifier.value",
    "NotificationCategory": "Bundle.entry.resource.where($this is DiagnosticReport).code.coding.where(system='https://demis.rki.de/fhir/CodeSystem/notificationCategory').code",
    "NotificationDiseaseCategory": "Bundle.entry.resource.where($this is Condition).code.coding.where(system='https://demis.rki.de/fhir/CodeSystem/notificationDiseaseCategory').code",
    "Composition.status(final)": "Bundle.entry.resource.where($this is Composition).where(status = 'final').exists()",
    "Composition.status(amended)": "Bundle.entry.resource.where($this is Composition).where(status = 'amended').exists()",
    "Composition.status(preliminary)": "Bundle.entry.resource.where($this is Composition).where(status = 'preliminary').exists()",
    "DiagnosticReport.status(amended)": "Bundle.entry.resource.where($this is DiagnosticReport).where(status = 'amended').exists()",
    "DiagnosticReport.status(final)": "Bundle.entry.resource.where($this is DiagnosticReport).where(status = 'final').exists()",
    "DiagnosticReport.status(preliminary)": "Bundle.entry.resource.where($this is DiagnosticReport).where(status = 'preliminary').exists()",
    "DiagnosticReport.status(corrected)": "Bundle.entry.resource.where($this is DiagnosticReport).where(status = 'corrected').exists()",
    "DiagnosticReport.conclusionCode(pathogenDetected)": "Bundle.entry.resource.where($this is DiagnosticReport).where(conclusionCode.coding.code.lower() = 'pathogendetected').exists()",
    "DiagnosticReport.conclusionCode(pathogenNotDetected)": "Bundle.entry.resource.where($this is DiagnosticReport).where(conclusionCode.coding.code.lower() = 'pathogennotdetected').exists()",
    "NotificationCategory(cvdp)": "Bundle.entry.resource.where($this is DiagnosticReport).where(code.coding.code.lower() = 'cvdp').exists()",
    "Observation.interpretation(neg)": "Bundle.entry.resource.where($this is Observation).where(interpretation.coding.code in ('NEG'|'260385009'|'ND'|'260415000')).count() >= 1",
    "Observation.interpretation(pos)": "Bundle.entry.resource.where($this is Observation).where(interpretation.coding.code in ('POS'|'10828004'|'DET'|'260373001'|'R'|'30714006'|'SYN-R'|'S'|'131196009'|'SDD'|'SYN-S'|'I'|'264841006'|'11896004')).count() >= 1",
    "Condition.clinicalStatus(active)": "Bundle.entry.resource.where($this is Condition).clinicalStatus.coding.where(code = 'active').exists() or (Bundle.meta.profile = 'https://demis.rki.de/fhir/StructureDefinition/NotificationBundleDisease' and Bundle.entry.resource.where($this is Condition).clinicalStatus.empty())",
    "Condition.clinicalStatus(inactive)": "Bundle.entry.resource.where($this is Condition).clinicalStatus.coding.where(code = 'inactive').exists() or (Bundle.meta.profile = 'https://demis.rki.de/fhir/StructureDefinition/NotificationBundleDisease' and Bundle.entry.resource.where($this is Condition).clinicalStatus.empty())",
    "Condition.verificationStatus(confirmed)": "Bundle.entry.resource.where($this is Condition).verificationStatus.coding.where(code = 'confirmed').exists()",
    "Condition.verificationStatus(unconfirmed)": "Bundle.entry.resource.where($this is Condition).verificationStatus.coding.where(code = 'unconfirmed').exists()",
    "Condition.verificationStatus(refuted)": "Bundle.entry.resource.where($this is Condition).verificationStatus.coding.where(code = 'refuted').exists()",
    "Condition.verificationStatus(entered-in-error)": "Bundle.entry.resource.where($this is Condition).verificationStatus.coding.where(code = 'entered-in-error').exists()",
    "Condition.verificationStatus(confirmed|unconfirmed|entered-in-error)": "Bundle.entry.resource.where($this is Condition).verificationStatus.coding.where(code = 'confirmed').exists() or Bundle.entry.resource.where($this is Condition).verificationStatus.coding.where(code = 'unconfirmed').exists() or Bundle.entry.resource.where($this is Condition).verificationStatus.coding.where(code = 'entered-in-error').exists()",
    "DiseaseInformationCommon.QuestionnaireResponse.status(completed)": "Bundle.entry.resource.where($this is Composition).section.code.coding.where(code = 'generalClinAndEpiInformation').empty() or Bundle.entry.resource.where($this is Composition).section.where($this.code.coding.where(code = 'generalClinAndEpiInformation')).entry.resolve().where(status = 'completed').exists()",
    "DiseaseInformationCommon.QuestionnaireResponse.status(amended)": "Bundle.entry.resource.where($this is Composition).section.code.coding.where(code = 'generalClinAndEpiInformation').empty() or Bundle.entry.resource.where($this is Composition).section.where($this.code.coding.where(code = 'generalClinAndEpiInformation')).entry.resolve().where(status = 'amended').exists()",
    "DiseaseInformationCommon.QuestionnaireResponse.status(completed or amended)": "Bundle.entry.resource.where($this is Composition).section.code.coding.where(code = 'generalClinAndEpiInformation').empty() or Bundle.entry.resource.where($this is Composition).section.where($this.code.coding.where(code = 'generalClinAndEpiInformation')).entry.resolve().where(status = 'completed' or status = 'amended').exists()",
    "DiseaseInformationXYZD.QuestionnaireResponse.status(completed)": "Bundle.entry.resource.where($this is Composition).section.code.coding.where(code = 'specificClinAndEpiInformation').empty() or Bundle.entry.resource.where($this is Composition).section.where($this.code.coding.where(code = 'specificClinAndEpiInformation')).entry.resolve().where(status = 'completed').exists()",
    "DiseaseInformationXYZD.QuestionnaireResponse.status(amended)": "Bundle.entry.resource.where($this is Composition).section.code.coding.where(code = 'specificClinAndEpiInformation').empty() or Bundle.entry.resource.where($this is Composition).section.where($this.code.coding.where(code = 'specificClinAndEpiInformation')).entry.resolve().where(status = 'amended').exists()",
    "DiseaseInformationXYZD.QuestionnaireResponse.status(completed or amended)": "Bundle.entry.resource.where($this is Composition).section.code.coding.where(code = 'specificClinAndEpiInformation').empty() or Bundle.entry.resource.where($this is Composition).section.where($this.code.coding.where(code = 'specificClinAndEpiInformation')).entry.resolve().where(status = 'completed' or status = 'amended').exists()",
    "DiseaseInformationCommon.linkId(isDead=true)": "Bundle.entry.resource.where($this is Composition).section.where($this.code.coding.where(code = 'generalClinAndEpiInformation')).entry.resolve().item.where($this.linkId = 'isDead').answer.value.where(code = 'yes').exists()",
    "DiseaseInformationCommon.linkId(isDead=false)": "Bundle.entry.resource.where($this is Composition).section.where($this.code.coding.where(code = 'generalClinAndEpiInformation')).entry.resolve().item.where($this.linkId = 'isDead').answer.value.where(code = 'no' or code = 'ASKU' or code = 'NASK').exists()"
  }
]